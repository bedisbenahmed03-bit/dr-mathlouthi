---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Avant & Après — Dr. Omar Mathlouthi</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: #0B1F3A; font-family: 'Inter', sans-serif; color: white; }
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between;
        padding: 20px 40px;
        background: rgba(11,31,58,0.97);
        border-bottom: 1px solid rgba(201,168,76,0.15);
      }
      .nav-logo-wrap { display: flex; flex-direction: column; }
      .nav-logo { font-family: 'Playfair Display', serif; color: white; font-size: 1.1rem; }
      .nav-slogan { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A84C; margin-top: 2px; }
      .nav-back { font-size: 0.85rem; font-weight: 500; padding: 10px 24px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.3); color: white; text-decoration: none; transition: all 0.3s; }
      .nav-back:hover { background: white; color: #0B1F3A; }
      .page-hero { padding: 140px 24px 60px; text-align: center; }
      .eyebrow { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A84C; margin-bottom: 16px; }
      .page-title { font-family: 'Playfair Display', serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; color: white; margin-bottom: 16px; }
      .page-subtitle { font-size: 1rem; color: rgba(255,255,255,0.6); max-width: 500px; margin: 0 auto; line-height: 1.7; }
      .gallery-container { max-width: 1100px; margin: 0 auto; padding: 40px 24px 100px; }
      .case-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.12); border-radius: 16px; overflow: hidden; transition: border-color 0.3s, transform 0.3s; }
      .case-card:hover { border-color: rgba(201,168,76,0.35); transform: translateY(-2px); }
      .case-image-wrap { position: relative; overflow: hidden; cursor: pointer; background: #060f1e; }
      .case-image { width: 100%; height: 220px; object-fit: cover; display: block; transition: transform 0.5s ease; }
      .case-image-wrap:hover .case-image { transform: scale(1.02); }
      .case-image-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(11,31,58,0.85) 0%, transparent 60%);
        display: flex; align-items: flex-end; padding: 28px;
        opacity: 0; transition: opacity 0.3s;
      }
      .case-image-wrap:hover .case-image-overlay { opacity: 1; }
      .case-footer { display: flex; align-items: center; justify-content: space-between; padding: 20px 28px; flex-wrap: wrap; gap: 12px; }
      .case-tag { display: inline-block; padding: 4px 14px; border-radius: 999px; background: rgba(201,168,76,0.12); color: #C9A84C; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; }
      .case-title-small { font-family: 'Playfair Display', serif; font-size: 1rem; color: rgba(255,255,255,0.9); margin-top: 6px; }
      .btn-voir { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 999px; background: #C9A84C; color: #0B1F3A; font-weight: 600; font-size: 0.85rem; border: none; cursor: pointer; transition: all 0.3s; }
      .btn-voir:hover { opacity: 0.9; transform: scale(1.03); }

      /* LIGHTBOX */
      .lightbox { display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,0.92); align-items: center; justify-content: center; padding: 16px; }
      .lightbox.active { display: flex; }
      .lightbox-close { position: absolute; top: 16px; right: 20px; color: white; font-size: 1.6rem; cursor: pointer; opacity: 0.7; transition: opacity 0.2s; z-index: 1001; background: rgba(255,255,255,0.1); border: none; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
      .lightbox-close:hover { opacity: 1; background: rgba(255,255,255,0.2); }

      .lightbox-inner {
        display: flex;
        width: 100%;
        max-width: 1000px;
        max-height: 90vh;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
      }

      .lightbox-img-side {
        flex: 1;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 300px;
      }
      .lightbox-img-side img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        max-height: 90vh;
      }

      .lightbox-desc-side {
        width: 320px;
        min-width: 280px;
        background: #060f1e;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        transform: translateX(40px);
        opacity: 0;
        transition: transform 0.5s cubic-bezier(0.16,1,0.3,1), opacity 0.5s ease;
      }
      .lightbox.active .lightbox-desc-side {
        transform: translateX(0);
        opacity: 1;
        transition-delay: 0.15s;
      }

      .lightbox-desc-content { padding: 32px 28px; display: flex; flex-direction: column; min-height: 100%; }
      .lightbox-eyebrow { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A84C; margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
      .lightbox-eyebrow::before { content: ''; display: block; width: 24px; height: 1px; background: #C9A84C; }
      .lightbox-tag-large { display: inline-block; padding: 5px 16px; border-radius: 999px; background: rgba(201,168,76,0.12); color: #C9A84C; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 16px; }
      .lightbox-title { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; color: white; line-height: 1.3; margin-bottom: 16px; }
      .lightbox-divider { width: 40px; height: 2px; background: #C9A84C; margin-bottom: 16px; }
      .lightbox-text { font-size: 0.88rem; line-height: 1.8; color: rgba(255,255,255,0.65); margin-bottom: 24px; }
      .lightbox-details { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
      .lightbox-detail { display: flex; align-items: center; gap: 10px; font-size: 0.82rem; color: rgba(255,255,255,0.7); padding: 9px 12px; background: rgba(255,255,255,0.04); border-radius: 8px; border-left: 2px solid #C9A84C; }
      .lightbox-cta { display: inline-block; padding: 13px 24px; border-radius: 999px; background: #C9A84C; color: #0B1F3A; font-weight: 600; font-size: 0.88rem; text-decoration: none; text-align: center; transition: all 0.3s; margin-top: auto; }
      .lightbox-cta:hover { opacity: 0.9; transform: scale(1.02); }

      .cta-section { text-align: center; padding: 60px 24px 100px; border-top: 1px solid rgba(255,255,255,0.08); }
      .cta-section h2 { font-family: 'Playfair Display', serif; font-size: 2rem; color: white; margin-bottom: 16px; }
      .cta-section p { color: rgba(255,255,255,0.6); margin-bottom: 32px; }
      .btn-gold { display: inline-block; padding: 16px 40px; border-radius: 999px; background: #C9A84C; color: #0B1F3A; font-weight: 600; text-decoration: none; transition: all 0.3s; }
      .btn-gold:hover { opacity: 0.9; transform: scale(1.03); }
      .footer-mini { display: block; text-align: center; padding: 24px; font-size: 0.8rem; color: rgba(255,255,255,0.3); border-top: 1px solid rgba(255,255,255,0.06); }

      @media (max-width: 768px) {
        /* Scroll the whole panel, top-aligned so nothing is clipped off-screen */
        .lightbox { align-items: flex-start; padding: 12px; }
        .lightbox-inner {
          flex-direction: column;
          max-height: calc(100vh - 24px);
          max-height: calc(100dvh - 24px);
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
          border-radius: 16px;
        }
        /* Neither side may grow or shrink: the inner scrolls past both */
        .lightbox-img-side { flex: 0 0 auto; min-height: 200px; max-height: 45vh; }
        .lightbox-img-side img { object-fit: contain; max-height: 45vh; }
        .lightbox-desc-side { width: 100%; min-width: unset; flex: 0 0 auto; overflow-y: visible; transform: translateY(20px); }
        .lightbox.active .lightbox-desc-side { transform: translateY(0); }
        /* min-height:100% + margin-top:auto pinned the CTA below the fold */
        .lightbox-desc-content { min-height: 0; padding: 24px 20px 28px; }
        .lightbox-cta { margin-top: 20px; }
        nav { padding: 16px 20px; }
      }
    </style>
  </head>
  <body>

    <nav>
      <div class="nav-logo-wrap">
        <span class="nav-logo">Dr. Omar Mathlouthi</span>
        <span class="nav-slogan">Wear your best smile</span>
      </div>
      <div style="display:flex; align-items:center; gap:12px;">
        <div class="lang-switcher" style="display:flex; align-items:center; gap:4px;">
          <button class="lang-btn active" onclick="setLang('fr')" style="background:transparent; border:none; color:rgba(255,255,255,0.5); font-size:0.75rem; font-weight:500; cursor:pointer; padding:4px 8px; border-radius:4px; transition:all 0.2s; font-family:'Inter',sans-serif;">FR</button>
          <span style="color:rgba(255,255,255,0.2); font-size:0.7rem;">|</span>
          <button class="lang-btn" onclick="setLang('en')" style="background:transparent; border:none; color:rgba(255,255,255,0.5); font-size:0.75rem; font-weight:500; cursor:pointer; padding:4px 8px; border-radius:4px; transition:all 0.2s; font-family:'Inter',sans-serif;">EN</button>
          <span style="color:rgba(255,255,255,0.2); font-size:0.7rem;">|</span>
          <button class="lang-btn" onclick="setLang('ar')" style="background:transparent; border:none; color:rgba(255,255,255,0.5); font-size:0.75rem; font-weight:500; cursor:pointer; padding:4px 8px; border-radius:4px; transition:all 0.2s; font-family:'Inter',sans-serif;">AR</button>
        </div>
        <a href="/" class="nav-back" id="back-btn">← Retour</a>
      </div>
    </nav>

    <div class="page-hero">
      <p class="eyebrow">Résultats réels</p>
      <h1 class="page-title">Avant & Après</h1>
      <p class="page-subtitle">Des transformations authentiques réalisées au cabinet du Dr. Omar Mathlouthi à Sousse.</p>
    </div>

    <div class="gallery-container"><div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap:20px;">

      <div class="case-card">
        <div class="case-image-wrap" data-index="0">
          <img class="case-image" src="/images/work1.jpg" alt="Bridge Zircone" />
          <div class="case-image-overlay">
            <button class="btn-voir" data-index="0">✦ Voir la description</button>
          </div>
        </div>
        <div class="case-footer">
          <div>
            <span class="case-tag">Prothèse</span>
            <div class="case-title-small">Bridge 7 Éléments en Zircone</div>
          </div>
          <button class="btn-voir" data-index="0">✦ Voir la description</button>
        </div>
      </div>

      <div class="case-card">
        <div class="case-image-wrap" data-index="1">
          <img class="case-image" src="/images/work2.jpg" alt="Couronnes Zircone" />
          <div class="case-image-overlay">
            <button class="btn-voir" data-index="1">✦ Voir la description</button>
          </div>
        </div>
        <div class="case-footer">
          <div>
            <span class="case-tag">Prothèse</span>
            <div class="case-title-small">4 Couronnes Zircone & Fermeture Diastème</div>
          </div>
          <button class="btn-voir" data-index="1">✦ Voir la description</button>
        </div>
      </div>

      <div class="case-card">
        <div class="case-image-wrap" data-index="2">
          <img class="case-image" src="/images/work3.jpg" alt="Blanchiment" />
          <div class="case-image-overlay">
            <button class="btn-voir" data-index="2">✦ Voir la description</button>
          </div>
        </div>
        <div class="case-footer">
          <div>
            <span class="case-tag">Blanchiment</span>
            <div class="case-title-small">Détartrage + Blanchiment Dentaire</div>
          </div>
          <button class="btn-voir" data-index="2">✦ Voir la description</button>
        </div>
      </div>

      <div class="case-card">
        <div class="case-image-wrap" data-index="3">
          <img class="case-image" src="/images/work4.jpg" alt="Résine Composite" />
          <div class="case-image-overlay">
            <button class="btn-voir" data-index="3">✦ Voir la description</button>
          </div>
        </div>
        <div class="case-footer">
          <div>
            <span class="case-tag">Sculpture</span>
            <div class="case-title-small">Sculpture Résine Composite & Fermeture Diastème</div>
          </div>
          <button class="btn-voir" data-index="3">✦ Voir la description</button>
        </div>
      </div>

      <div class="case-card">
        <div class="case-image-wrap" data-index="4">
          <img class="case-image" src="/images/work5.jpg" alt="Transformation Esthétique" />
          <div class="case-image-overlay">
            <button class="btn-voir" data-index="4">✦ Voir la description</button>
          </div>
        </div>
        <div class="case-footer">
          <div>
            <span class="case-tag">Esthétique</span>
            <div class="case-title-small">Transformation Esthétique Complète</div>
          </div>
          <button class="btn-voir" data-index="4">✦ Voir la description</button>
        </div>
      </div>

    </div></div>

    <div class="cta-section">
      <h2>Vous aussi, transformez votre sourire</h2>
      <p>Prenez rendez-vous pour une consultation personnalisée avec le Dr. Mathlouthi.</p>
      <a href="/#booking" class="btn-gold">Réserver une consultation</a>
    </div>

    <div class="footer-mini">© 2025 Dr. Omar Mathlouthi · Wear your best smile ✨</div>

    <div class="lightbox" id="lightbox">
      <button class="lightbox-close" id="lightbox-close">×</button>
      <div class="lightbox-inner">
        <div class="lightbox-img-side">
          <img id="lightbox-img" src="" alt="" />
        </div>
        <div class="lightbox-desc-side">
          <div class="lightbox-desc-content">
            <div class="lightbox-eyebrow">Cabinet Dr. Mathlouthi</div>
            <span class="lightbox-tag-large" id="lb-tag"></span>
            <h2 class="lightbox-title" id="lb-title"></h2>
            <div class="lightbox-divider"></div>
            <p class="lightbox-text" id="lb-desc"></p>
            <div class="lightbox-details" id="lb-details"></div>
            <a href="/#booking" class="lightbox-cta">Prendre rendez-vous</a>
          </div>
        </div>
      </div>
    </div>

    <script>
      const cases = [
        {
          img: '/images/work1.jpg',
          tag: 'Prothèse',
          title: 'Bridge 7 Éléments en Zircone',
          desc: 'Patient présentant une dent mobile, une dent manquante et un ancien bridge CIV résine défectueux. Remplacement complet par un bridge 7 éléments en zircone pour un résultat naturel, solide et durable.',
          details: ['🦷 Bridge Zircone 7 éléments', '⏱ 2 séances', '✨ Résultat immédiat', '📍 Cabinet Dr. Mathlouthi']
        },
        {
          img: '/images/work2.jpg',
          tag: 'Prothèse',
          title: '4 Couronnes Zircone & Fermeture Diastème',
          desc: 'Deux anciennes couronnes défectueuses réalisées en Angleterre avec un diastème de 2mm. Remplacement complet par 4 couronnes en zircone avec fermeture totale du diastème.',
          details: ['👑 4 Couronnes Zircone', '📐 Fermeture diastème 2mm', '✨ Faites en Tunisie', '💎 Qualité premium']
        },
        {
          img: '/images/work3.jpg',
          tag: 'Blanchiment',
          title: 'Détartrage + Blanchiment Dentaire',
          desc: 'Détartrage professionnel suivi d\'un blanchiment dentaire en cabinet. Résultat : sourire éclatant et dents plusieurs teintes plus blanches en une seule séance confortable.',
          details: ['⚪ Blanchiment professionnel', '⏱ 1 séance', '✨ Effet immédiat', '🌟 Résultat durable']
        },
        {
          img: '/images/work4.jpg',
          tag: 'Sculpture',
          title: 'Sculpture Résine Composite & Fermeture Diastème',
          desc: 'Fermeture d\'un diastème par sculpture en résine composite. Technique non invasive offrant un résultat naturel et harmonieux sans toucher à la structure originale de la dent.',
          details: ['🎨 Résine composite', '🌿 Technique non invasive', '⏱ 1 séance', '✨ Résultat naturel']
        },
        {
          img: '/images/work5.jpg',
          tag: 'Esthétique',
          title: 'Transformation Esthétique Complète',
          desc: 'Transformation complète du sourire avec un résultat naturel et élégant. Chaque détail soigneusement planifié pour offrir une harmonie parfaite entre les dents et le visage du patient.',
          details: ['✨ Design du sourire', '💎 Résultat premium', '📍 Sousse, Tunisie', '🏆 Excellence esthétique']
        }
      ];

      function openLightbox(i) {
        const c = cases[i];
        document.getElementById('lightbox-img').src = c.img;
        document.getElementById('lb-tag').textContent = c.tag;
        document.getElementById('lb-title').textContent = c.title;
        document.getElementById('lb-desc').textContent = c.desc;
        document.getElementById('lb-details').innerHTML = c.details.map(d => `<div class="lightbox-detail">${d}</div>`).join('');
        document.getElementById('lightbox').classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        document.getElementById('lightbox').classList.remove('active');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.case-image-wrap').forEach(wrap => {
        wrap.addEventListener('click', () => openLightbox(Number(wrap.dataset.index)));
      });

      document.querySelectorAll('.btn-voir').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          openLightbox(Number(btn.dataset.index));
        });
      });

      document.getElementById('lightbox-close').addEventListener('click', closeLightbox);

      document.getElementById('lightbox').addEventListener('click', function(e) {
        if (e.target === this) closeLightbox();
      });

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeLightbox();
      });
    </script>

  <script>
      const t = {
        fr: { back:'← Retour', title:'Avant & Après', subtitle:'Des transformations authentiques réalisées au cabinet du Dr. Omar Mathlouthi à Sousse.', eyebrow:'Résultats réels', cta_title:'Vous aussi, transformez votre sourire', cta_sub:'Prenez rendez-vous pour une consultation personnalisée avec le Dr. Mathlouthi.', cta_btn:'Réserver une consultation' },
        en: { back:'← Back', title:'Before & After', subtitle:'Authentic transformations performed at Dr. Omar Mathlouthi\'s clinic in Sousse.', eyebrow:'Real results', cta_title:'Transform your smile too', cta_sub:'Book a personalized consultation with Dr. Mathlouthi.', cta_btn:'Book a consultation' },
        ar: { back:'← رجوع', title:'قبل وبعد', subtitle:'تحولات حقيقية تمت في عيادة الدكتور عمر المثلوثي في سوسة.', eyebrow:'نتائج حقيقية', cta_title:'حوّل ابتسامتك أنت أيضاً', cta_sub:'احجز استشارة شخصية مع الدكتور عمر المثلوثي.', cta_btn:'احجز استشارة' }
      };

      window.setLang = function(lang) {
        const l = t[lang];
        const isRTL = lang === 'ar';
        document.body.style.direction = isRTL ? 'rtl' : 'ltr';
        document.getElementById('back-btn').textContent = l.back;
        document.querySelector('.page-title').textContent = l.title;
        document.querySelector('.page-subtitle').textContent = l.subtitle;
        document.querySelector('.eyebrow').textContent = l.eyebrow;
        document.querySelector('.cta-section h2').textContent = l.cta_title;
        document.querySelector('.cta-section p').textContent = l.cta_sub;
        document.querySelector('.btn-gold').textContent = l.cta_btn;
        document.querySelectorAll('.lang-btn').forEach(btn => {
          btn.style.color = btn.textContent === lang.toUpperCase() ? '#C9A84C' : 'rgba(255,255,255,0.5)';
        });
      };
    </script>
  </body>
</html>