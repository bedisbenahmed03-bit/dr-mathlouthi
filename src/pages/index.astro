    <script>
      // THEME TOGGLE
      document.getElementById('theme-toggle').addEventListener('click', function() {
        const isLight = document.body.classList.contains('light-mode');
        document.body.classList.toggle('light-mode');
        this.textContent = isLight ? '☀️' : '🌙';
      });

      // BOOKING FORM
      document.getElementById('confirm-btn').addEventListener('click', function() {
        const name = document.getElementById('booking-name').value;
        const phone = document.getElementById('booking-phone').value;
        const date = document.getElementById('booking-date').value;
        const time = document.getElementById('booking-time').value;
        const care = document.getElementById('booking-care').value;
        if (!name || !phone || !date || !time || !care) {
          alert('Veuillez remplir tous les champs obligatoires.');
          return;
        }
        const formatDate = new Date(date).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
        document.getElementById('conf-name').textContent = name;
        document.getElementById('conf-phone').textContent = phone;
        document.getElementById('conf-date').textContent = formatDate;
        document.getElementById('conf-time').textContent = time;
        document.getElementById('conf-care').textContent = care;
        document.getElementById('booking-overlay').style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });

      document.getElementById('conf-close-btn').addEventListener('click', function() {
        document.getElementById('booking-overlay').style.display = 'none';
        document.body.style.overflow = '';
      });

      // FAQ
      const faqs = [
        { q: "Comment prendre rendez-vous ?", a: "Contactez-nous par téléphone au 98 699 295 ou via WhatsApp. La réservation en ligne sera bientôt disponible directement depuis ce site." },
        { q: "Combien coûte une consultation ?", a: "La première consultation est dédiée à l'évaluation de votre situation. Le Dr. Mathlouthi vous proposera un plan de traitement personnalisé avec un devis détaillé et transparent." },
        { q: "Les facettes font-elles mal ?", a: "Non. La pose de facettes est une procédure non douloureuse réalisée sous anesthésie locale si nécessaire. La plupart des patients reprennent leurs activités normales le jour même." },
        { q: "Combien de temps dure un blanchiment ?", a: "Une séance de blanchiment professionnel en cabinet dure environ 1 heure. Les résultats sont immédiats et peuvent durer plusieurs années avec un bon entretien." },
        { q: "Les implants dentaires sont-ils durables ?", a: "Oui. Les implants en titane sont conçus pour durer toute une vie. Avec un entretien correct et des visites régulières, ils offrent une solution permanente et naturelle." },
        { q: "Acceptez-vous les patients étrangers ?", a: "Absolument. Le cabinet du Dr. Mathlouthi accueille régulièrement des patients venant de France, d'Italie et d'autres pays pour des soins esthétiques de haute qualité à des tarifs compétitifs." },
        { q: "Quelle est la différence entre couronne et facette ?", a: "Une facette couvre uniquement la face visible de la dent (traitement esthétique). Une couronne enveloppe toute la dent (traitement restaurateur). Le Dr. Mathlouthi vous conseillera la meilleure option selon votre cas." },
        { q: "Où se trouve le cabinet ?", a: "Le cabinet est situé en face de la clinique el Yosr Internationale, Immeuble le 103, Avenue IBN EL Jazzar, Sousse 4002, Tunisie." },
      ];

      const list = document.getElementById('faq-list');
      faqs.forEach((item, i) => {
        list.innerHTML += `
          <div style="border-bottom:1px solid #e5e7eb; overflow:hidden;">
            <button data-faq="${i}" style="width:100%; display:flex; align-items:center; justify-content:space-between; padding:24px 0; background:none; border:none; cursor:pointer; text-align:left;">
              <span style="font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:600; color:#0B1F3A;">${item.q}</span>
              <span id="icon-${i}" style="color:#C9A84C; font-size:1.4rem; font-weight:300; transition:transform 0.3s; flex-shrink:0; margin-left:16px;">+</span>
            </button>
            <div id="faq-${i}" style="max-height:0; overflow:hidden; transition:max-height 0.4s ease;">
              <p style="padding:0 0 24px; font-size:0.95rem; line-height:1.8; color:#4a5568;">${item.a}</p>
            </div>
          </div>
        `;
      });

      document.addEventListener('click', function(e) {
        const btn = e.target.closest('[data-faq]');
        if (btn) toggleFaq(Number(btn.dataset.faq));
      });

      function toggleFaq(i) {
        const content = document.getElementById('faq-' + i);
        const icon = document.getElementById('icon-' + i);
        if (!content || !icon) return;
        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
        for (let j = 0; j < faqs.length; j++) {
          const el = document.getElementById('faq-' + j);
          const ic = document.getElementById('icon-' + j);
          if (el) el.style.maxHeight = '0px';
          if (ic) { ic.textContent = '+'; ic.style.transform = 'rotate(0deg)'; }
        }
        if (!isOpen) {
          content.style.maxHeight = '300px';
          icon.style.transform = 'rotate(45deg)';
        }
      }
    </script>

