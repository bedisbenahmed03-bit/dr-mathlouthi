---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dr. Omar Mathlouthi — Dentiste Esthétique à Sousse</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&family=Noto+Sans+Arabic:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: #ffffff; font-family: 'Inter', sans-serif; color: #0B1F3A; transition: background 0.3s, color 0.3s; }
      body.rtl { direction: rtl; font-family: 'Noto Sans Arabic', sans-serif; }

      /* LIGHT MODE */
      body.light-mode .about { background: #f5f0e8; }
      body.light-mode .services { background: #ede8de; }
      body.light-mode .service-card { background: #f5f0e8; }
      body.light-mode .why { background: #ede8de; }
      body.light-mode .why-card { background: #f5f0e8; }
      body.light-mode .testimonials { background: #f5f0e8; }
      body.light-mode .testimonial-card { background: #ede8de; }
      body.light-mode .stat { background: #ede8de; }
      body.light-mode #faq { background: #f5f0e8 !important; }

      /* NAV */
      nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 20px 40px; background: linear-gradient(to bottom, rgba(11,31,58,0.95), transparent); }
      .nav-logo-wrap { display: flex; flex-direction: column; }
      .nav-logo { font-family: 'Playfair Display', serif; color: white; font-size: 1.1rem; letter-spacing: 0.05em; line-height: 1.2; }
      .nav-slogan { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: #C9A84C; margin-top: 2px; }
      .nav-right { display: flex; align-items: center; gap: 12px; }
      .theme-btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(201,168,76,0.4); background: transparent; color: #C9A84C; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: all 0.3s; }
      .theme-btn:hover { background: rgba(201,168,76,0.1); }
      .lang-switcher { display: flex; align-items: center; gap: 4px; }
      .lang-btn { background: transparent; border: none; color: rgba(255,255,255,0.5); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; cursor: pointer; padding: 4px 8px; border-radius: 4px; transition: all 0.2s; font-family: 'Inter', sans-serif; }
      .lang-btn:hover { color: #C9A84C; }
      .lang-btn.active { color: #C9A84C; border-bottom: 1px solid #C9A84C; }
      .lang-divider { color: rgba(255,255,255,0.2); font-size: 0.7rem; }
      .nav-btn { font-size: 0.85rem; font-weight: 500; padding: 10px 24px; border-radius: 999px; border: 1px solid #C9A84C; color: #C9A84C; text-decoration: none; transition: all 0.3s; }
      .nav-btn:hover { background: #C9A84C; color: #0B1F3A; }

      /* HERO */
      .hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
      .hero-bg { position: absolute; inset: 0; z-index: 0; background-image: url('/images/cabinet2.jpg'); background-size: cover; background-position: center; }
      .hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(135deg, rgba(11,31,58,0.92) 0%, rgba(11,31,58,0.75) 100%); }
      .hero-gold-line { position: absolute; left: 0; top: 0; width: 3px; height: 100%; z-index: 2; background: linear-gradient(to bottom, transparent, #C9A84C, transparent); }
      .hero-content { position: relative; z-index: 3; text-align: center; padding: 0 24px; max-width: 900px; margin: 0 auto; }
      .hero-eyebrow { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A84C; margin-bottom: 24px; }
      .hero-title { font-family: 'Playfair Display', serif; color: white; font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 700; line-height: 1.15; margin-bottom: 24px; }
      .hero-title em { color: #C9A84C; font-style: italic; }
      .hero-subtitle { font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 300; color: rgba(255,255,255,0.75); max-width: 600px; margin: 0 auto 40px; line-height: 1.7; }
      .hero-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
      .btn-primary { padding: 16px 36px; border-radius: 999px; font-weight: 600; font-size: 0.95rem; background: #C9A84C; color: #0B1F3A; text-decoration: none; transition: all 0.3s; display: inline-block; }
      .btn-primary:hover { opacity: 0.9; transform: scale(1.03); }
      .btn-secondary { padding: 16px 36px; border-radius: 999px; font-weight: 500; font-size: 0.95rem; border: 1px solid rgba(255,255,255,0.4); color: white; text-decoration: none; transition: all 0.3s; display: inline-block; }
      .btn-secondary:hover { background: white; color: #0B1F3A; }
      .scroll-indicator { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; z-index: 10; }
      .scroll-indicator span { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
      .scroll-line { width: 1px; height: 48px; background: linear-gradient(to bottom, rgba(201,168,76,0.8), transparent); }

      /* ABOUT */
      .about { background: #ffffff; padding: 100px 24px; }
      .about-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 60px; align-items: center; }
      .about-text { flex: 1; min-width: 280px; }
      .section-eyebrow { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A84C; margin-bottom: 16px; }
      .section-title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; color: #0B1F3A; line-height: 1.2; margin-bottom: 24px; }
      .about-text p { font-size: 1rem; line-height: 1.8; color: #4a5568; margin-bottom: 16px; }
      .about-photos { flex: 1; min-width: 280px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .about-photo-main { grid-column: 1 / -1; height: 280px; border-radius: 16px; overflow: hidden; }
      .about-photo-main img { width: 100%; height: 100%; object-fit: cover; }
      .about-photo-small { height: 180px; border-radius: 12px; overflow: hidden; }
      .about-photo-small img { width: 100%; height: 100%; object-fit: cover; }
      .stats { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
      .stat { flex: 1; min-width: 100px; background: #f8f7f4; border-radius: 16px; padding: 24px 16px; text-align: center; border-bottom: 3px solid #C9A84C; }
      .stat-number { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 700; color: #0B1F3A; }
      .stat-label { font-size: 0.8rem; color: #6b7280; margin-top: 4px; }

      /* SERVICES */
      .services { background: #f8f7f4; padding: 100px 24px; }
      .services-inner { max-width: 1100px; margin: 0 auto; }
      .section-header { text-align: center; margin-bottom: 60px; }
      .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
      .service-card { background: white; border-radius: 16px; padding: 36px 28px; border-top: 3px solid #C9A84C; transition: transform 0.3s, box-shadow 0.3s; }
      .service-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(11,31,58,0.08); }
      .service-icon { width: 52px; height: 52px; background: #fff8ec; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 1.6rem; }
      .service-card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 600; color: #0B1F3A; margin-bottom: 12px; }
      .service-card p { font-size: 0.9rem; line-height: 1.7; color: #6b7280; }

      /* GALLERY */
      .gallery { background: #0B1F3A; padding: 100px 24px; }
      .gallery-inner { max-width: 1100px; margin: 0 auto; }
      .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 48px; }
      .gallery-card { border-radius: 16px; overflow: hidden; position: relative; background: #1a3a5c; }
      .gallery-card img { width: 100%; height: 280px; object-fit: cover; display: block; }
      .gallery-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; background: linear-gradient(to top, rgba(11,31,58,0.95), transparent); }
      .gallery-label span { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: #C9A84C; }

      /* WHY */
      .why { background: #f8f7f4; padding: 100px 24px; }
      .why-inner { max-width: 1100px; margin: 0 auto; }
      .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; margin-top: 48px; }
      .why-card { background: white; border-radius: 16px; padding: 32px 24px; text-align: center; }
      .why-icon { font-size: 2rem; margin-bottom: 16px; }
      .why-card h3 { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 600; color: #0B1F3A; margin-bottom: 10px; }
      .why-card p { font-size: 0.85rem; line-height: 1.7; color: #6b7280; }

      /* TESTIMONIALS */
      .testimonials { background: #ffffff; padding: 100px 24px; }
      .testimonials-inner { max-width: 1100px; margin: 0 auto; }
      .testimonials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 48px; }
      .testimonial-card { background: #f8f7f4; border-radius: 16px; padding: 32px 28px; border-left: 3px solid #C9A84C; }
      .stars { color: #C9A84C; font-size: 1rem; margin-bottom: 16px; }
      .testimonial-card p { font-size: 0.95rem; line-height: 1.8; color: #4a5568; margin-bottom: 20px; font-style: italic; }
      .testimonial-author { font-weight: 600; font-size: 0.9rem; color: #0B1F3A; }

      /* FOOTER */
      footer { background: #060f1e; padding: 80px 24px 40px; }
      .footer-inner { max-width: 1100px; margin: 0 auto; }
      .footer-top { display: flex; flex-wrap: wrap; gap: 48px; margin-bottom: 60px; }
      .footer-brand { flex: 2; min-width: 220px; }
      .footer-logo { font-family: 'Playfair Display', serif; color: white; font-size: 1.3rem; margin-bottom: 6px; }
      .footer-slogan { font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: #C9A84C; margin-bottom: 16px; }
      .footer-brand p { font-size: 0.9rem; line-height: 1.7; color: rgba(255,255,255,0.5); max-width: 300px; }
      .footer-col { flex: 1; min-width: 160px; }
      .footer-col h4 { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #C9A84C; margin-bottom: 20px; }
      .footer-col a, .footer-col p { display: block; font-size: 0.9rem; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 10px; line-height: 1.6; transition: color 0.2s; }
      .footer-col a:hover { color: #C9A84C; }
      .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 32px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; }
      .footer-bottom p { font-size: 0.8rem; color: rgba(255,255,255,0.3); }

      /* CONFIRMATION OVERLAY */
      #booking-overlay { display: none; position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,0.85); align-items: center; justify-content: center; padding: 24px; }
      .conf-card { background: #0d1810; border: 1px solid rgba(201,168,76,0.3); border-radius: 4px; padding: 56px 48px; max-width: 500px; width: 100%; text-align: center; }
      .conf-check { font-size: 2rem; color: #C9A84C; margin-bottom: 20px; }
      .conf-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 400; letter-spacing: 0.25em; text-transform: uppercase; color: #C9A84C; margin-bottom: 12px; }
      .conf-subtitle { font-size: 0.9rem; font-style: italic; color: rgba(255,255,255,0.6); line-height: 1.7; margin-bottom: 36px; font-family: 'Inter', sans-serif; }
      .conf-divider { border: none; border-top: 1px solid rgba(201,168,76,0.2); margin-bottom: 28px; }
      .conf-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
      .conf-label { font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.4); font-family: 'Inter', sans-serif; }
      .conf-value { font-size: 0.85rem; color: rgba(255,255,255,0.85); font-family: 'Inter', sans-serif; text-align: right; }
      .conf-close { margin-top: 36px; padding: 14px 40px; background: transparent; border: 1px solid rgba(201,168,76,0.4); border-radius: 2px; color: #C9A84C; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer; font-family: 'Inter', sans-serif; transition: all 0.3s; }
      .conf-close:hover { background: rgba(201,168,76,0.1); }

      /* MOBILE MENU */
      .hamburger { display: none; position: fixed; top: 16px; right: 20px; z-index: 110; width: 44px; height: 44px; padding: 0; background: transparent; border: none; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
      .hamburger span { display: block; width: 26px; height: 2px; background: #C9A84C; border-radius: 2px; transition: transform 0.3s, opacity 0.3s; }
      .hamburger.open span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
      .hamburger.open span:nth-child(2) { opacity: 0; }
      .hamburger.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
      .mobile-menu { display: none; position: fixed; inset: 0; z-index: 100; background: rgba(11,31,58,0.98); flex-direction: column; align-items: center; justify-content: center; gap: 32px; }
      .mobile-menu.open { display: flex; }
      .mobile-menu a.mobile-link { font-size: 1.1rem; color: rgba(255,255,255,0.85); text-decoration: none; letter-spacing: 0.05em; }
      .mobile-menu .lang-switcher { display: flex; }
      .mobile-menu .lang-btn { font-size: 0.95rem; padding: 6px 12px; }
      .mobile-menu .nav-btn { font-size: 0.95rem; padding: 14px 32px; }

      @media (max-width: 768px) {
        nav { padding: 16px 20px; }
        .about-inner, .footer-top { flex-direction: column; }
        .about-photos { grid-template-columns: 1fr; }
        .about-photo-main { height: 220px; }
        .nav-right { display: none; }
        .nav-desktop-link { display: none; }
        .hamburger { display: flex; }
      }
    </style>
  </head>
  <body>

    <!-- NAVBAR -->
    <nav>
      <div style="display:flex; align-items:center; gap:28px;">
      <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:12px;">
        <span style="font-size:1.6rem;">🦷</span>
        <div class="nav-logo-wrap">
          <span class="nav-logo">Dr. Omar Mathlouthi</span>
          <span class="nav-slogan" data-i18n="slogan">Wear your best smile</span>
        </div>
      </a>
      <a href="/avant-apres" class="nav-desktop-link" style="font-size:0.85rem; color:rgba(255,255,255,0.7); text-decoration:none; transition:color 0.3s; white-space:nowrap;" onmouseover="this.style.color='#C9A84C'" onmouseout="this.style.color='rgba(255,255,255,0.7)'">Avant & Après</a>
      </div>
      <div class="nav-right">
        <div class="lang-switcher">
          <button class="lang-btn active" onclick="setLang('fr')">FR</button>
          <span class="lang-divider">|</span>
          <button class="lang-btn" onclick="setLang('en')">EN</button>
          <span class="lang-divider">|</span>
          <button class="lang-btn" onclick="setLang('ar')">AR</button>
        </div>
        <button id="theme-toggle" class="theme-btn">☀️</button>
        <a href="#booking" class="nav-btn" data-i18n="nav_rdv">Prendre RDV</a>
      </div>
    </nav>

    <!-- MOBILE MENU -->
    <button id="hamburger" class="hamburger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div id="mobile-menu" class="mobile-menu">
      <a href="/avant-apres" class="mobile-link">Avant &amp; Après</a>
      <div class="lang-switcher">
        <button class="lang-btn active" onclick="setLang('fr')">FR</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" onclick="setLang('en')">EN</button>
        <span class="lang-divider">|</span>
        <button class="lang-btn" onclick="setLang('ar')">AR</button>
      </div>
      <button class="theme-btn">☀️</button>
      <a href="#booking" class="nav-btn" data-i18n="nav_rdv">Prendre RDV</a>
    </div>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="hero-overlay"></div>
      <div class="hero-gold-line"></div>
      <div class="hero-content">
        <p class="hero-eyebrow" data-i18n="hero_eyebrow">Dentisterie Esthétique · Sousse, Tunisie</p>
        <h1 class="hero-title" data-i18n="hero_title">Votre plus beau<br/><em data-i18n="hero_title_em">sourire</em> commence ici</h1>
        <p class="hero-subtitle" data-i18n="hero_subtitle">Spécialiste en design du sourire, facettes et blanchiment. Une approche personnalisée pour un résultat naturel et élégant.</p>
        <div class="hero-buttons">
          <a href="#booking" class="btn-primary" data-i18n="hero_btn1">Réserver une consultation</a>
          <a href="#services" class="btn-secondary" data-i18n="hero_btn2">Découvrir les soins</a>
        </div>
      </div>
      <div class="scroll-indicator">
        <span data-i18n="scroll">Découvrir</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about" id="about">
      <div class="about-inner">
        <div class="about-text">
          <p class="section-eyebrow" data-i18n="about_eyebrow">À propos</p>
          <h2 class="section-title" data-i18n="about_title">Une vision moderne de la dentisterie</h2>
          <p data-i18n="about_p1">Le Dr. Omar Mathlouthi est spécialiste en dentisterie esthétique à Sousse. Passionné par l'art du sourire, il combine des techniques de pointe avec une approche humaine et personnalisée.</p>
          <p data-i18n="about_p2">Son cabinet est équipé des dernières technologies pour vous offrir des soins précis, confortables et des résultats qui dépassent vos attentes.</p>
          <div class="stats">
            <div class="stat"><div class="stat-number">10+</div><div class="stat-label" data-i18n="stat1">Années d'expérience</div></div>
            <div class="stat"><div class="stat-number">500+</div><div class="stat-label" data-i18n="stat2">Sourires transformés</div></div>
            <div class="stat"><div class="stat-number">100%</div><div class="stat-label" data-i18n="stat3">Satisfaction patient</div></div>
          </div>
        </div>
        <div class="about-photos">
          <div class="about-photo-main"><img src="/images/doctor.jpg" alt="Dr. Omar Mathlouthi" /></div>
          <div class="about-photo-small"><img src="/images/cabinet1.jpg" alt="Cabinet" /></div>
          <div class="about-photo-small"><img src="/images/cabinet3.jpg" alt="Cabinet" /></div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services" id="services">
      <div class="services-inner">
        <div class="section-header">
          <p class="section-eyebrow" data-i18n="services_eyebrow">Nos soins</p>
          <h2 class="section-title" data-i18n="services_title">Des traitements d'excellence</h2>
        </div>
        <div class="services-grid">
          <div class="service-card"><div class="service-icon">✨</div><h3 data-i18n="s1_title">Design du Sourire</h3><p data-i18n="s1_desc">Transformation complète de votre sourire grâce à une planification digitale personnalisée.</p></div>
          <div class="service-card"><div class="service-icon">🦷</div><h3 data-i18n="s2_title">Facettes en Porcelaine</h3><p data-i18n="s2_desc">Des facettes ultra-fines en céramique pour corriger la forme, la couleur et l'alignement de vos dents.</p></div>
          <div class="service-card"><div class="service-icon">⚪</div><h3 data-i18n="s3_title">Blanchiment Dentaire</h3><p data-i18n="s3_desc">Techniques professionnelles de blanchiment pour un sourire éclatant avec des résultats durables.</p></div>
          <div class="service-card"><div class="service-icon">😁</div><h3 data-i18n="s4_title">Aligneurs Invisibles</h3><p data-i18n="s4_desc">Redressez vos dents discrètement avec des gouttières transparentes et amovibles.</p></div>
          <div class="service-card"><div class="service-icon">🔩</div><h3 data-i18n="s5_title">Implants Dentaires</h3><p data-i18n="s5_desc">Remplacez vos dents manquantes par des implants en titane offrant la solidité d'une dent naturelle.</p></div>
          <div class="service-card"><div class="service-icon">👑</div><h3 data-i18n="s6_title">Couronnes Zircone</h3><p data-i18n="s6_desc">Restaurez et protégez vos dents abîmées avec des couronnes en zircone personnalisées.</p></div>
        </div>
      </div>
    </section>

    <!-- BEFORE & AFTER -->
    <section class="gallery" id="gallery">
      <div class="gallery-inner">
        <div class="section-header">
          <p class="section-eyebrow" data-i18n="gallery_eyebrow">Résultats réels</p>
          <h2 class="section-title" style="color:white;" data-i18n="gallery_title">Avant & Après</h2>
          <p style="color:rgba(255,255,255,0.6); margin-top:16px; font-size:0.95rem;" data-i18n="gallery_sub">Des transformations réelles réalisées au cabinet du Dr. Mathlouthi</p>
        </div>
        <div class="gallery-grid">
